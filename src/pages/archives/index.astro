---
import { getBlogCollection, groupCollectionsByYear, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreview from '@/components/pure/PostPreview.astro'

export const prerender = true
const allPosts = await getBlogCollection()
const allPostsByYear = groupCollectionsByYear(sortMDByDate(allPosts))
const meta = { description: '按年份翻阅 Huazzi 的技术与生活记录。', title: '归档' }
---

<PageLayout {meta}>
  <main class='archives-page'>
    <div id='content-header' class='animate'>
      <p class='eyebrow'>THE ARCHIVE</p><h1 class='mt-3 mb-4'>时间留下的脚印。</h1><p
        class='text-sm text-muted-foreground'
      >
        共 {allPosts.length} 篇记录，慢慢积累，也慢慢回看。
      </p>
    </div>
    <section id='content' class='animate' aria-label='按年份归档的文章'>
      {
        allPostsByYear.map(([year, posts]) => (
          <section class='year-group'>
            <>
              <div class='year-heading'>
                <>
                  <h2>{year}</h2>
                  <span>{posts.length} 篇文章</span>
                </>
              </div>
              <ul>
                {posts.map((post) => (
                  <PostPreview {post} />
                ))}
              </ul>
            </>
          </section>
        ))
      }
    </section>
  </main>
</PageLayout>
<style>
  .archives-page {
    padding-top: 24px;
  }
  .year-group {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 36px;
    margin-bottom: 42px;
  }
  .year-heading {
    padding-top: 20px;
  }
  .year-heading h2 {
    font-family: var(--code-font);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.07em;
  }
  .year-heading span {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  @media (max-width: 640px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .year-heading {
      display: flex;
      align-items: center;
      gap: 18px;
    }
  }
</style>
