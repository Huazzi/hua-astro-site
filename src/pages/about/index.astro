---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  // { depth: 2, slug: 'gossips', text: 'Gossips' },
  { depth: 2, slug: 'education', text: 'Education' },
  // { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p>Developer</p>
  <p>A student of Zhengzhou University. Here are some things what I want to record.</p>
  <p>Motto: 须知少日拏云志，曾许人间第一流。</p>

{/* general-talk */}
<h2 id='hobbies'>Hobbies</h2>
<ul>
  <li>打篮球</li>
  <li>跑步</li>
  <li>编程</li>
  <li>吹晚风，看日落</li>
</ul>

{/* tools */}
<h2 id='tools'>Tools</h2>
<p>以下是我正在使用的一些工具：</p>
<ToolSection
  class='mb-5'
  title='Productivity'
  tools={[
    {
      name: 'Chrome',
      description: 'Browser',
      href: 'https://www.google.com/chrome/',
      icon: import('@/assets/tools/chrome.svg?raw')
    },
    {
      name: 'Typora',
      description: 'Markdown Editor',
      href: 'https://typora.io/',
      icon: import('@/assets/tools/typora.svg?raw')
    }
  ]}
/>
<ToolSection
  class='mb-5'
  title='Development'
  tools={[
    {
      name: 'VS Code',
      description: 'IDE',
      href: 'https://code.visualstudio.com/',
      icon: import('@/assets/tools/vscode.svg?raw')
    },
    {
      name: 'Claude Code',
      description: 'AI Coding Agent',
      href: 'https://claude.com/product/claude-code',
      icon: import('@/assets/tools/claudecode-color.svg?raw')
    },
    {
      name: 'Codex',
      description: 'AI Coding Agent',
      href: 'https://openai.com/zh-Hans-CN/codex/',
      icon: import('@/assets/tools/codex-color.svg?raw')
    },
    {
      name: 'LobeHub',
      description: 'AI Agent平台',
      href: 'https://www.lobehub.com/',
      icon: import('@/assets/tools/lobehub.svg?raw')
    }
  ]}
/>
<ToolSection
  class='mb-5'
  title='Environment'
  tools={[
    {
      name: 'Windows 11',
      description: 'Lenovo ThinkBook 16',
      href: 'https://news.microsoft.com/windows11-general-availability/',
      icon: import('@/assets/tools/windows11.svg?raw')
    },
    {
      name: 'Ubuntu 24.04 LTS',
      description: 'Linux Distribution',
      href: 'https://ubuntu.com/',
      icon: import('@/assets/tools/ubuntu.svg?raw')
    }
  ]}
/>

{/* social-networks */}
<h2 id='social-networks'>Social Networks</h2>
<p>你可以在以下平台找到我：</p>
<Substats
  stats={[
    {
      platform: 'GitHub',
      icon: 'github',
      link: 'https://github.com/Huazzi',
      text: 'followers',
      api: 'github/Huazzi'
    },
    {
      platform: 'Bilibili',
      icon: 'bilibili',
      color: '#fe7398',
      link: 'https://space.bilibili.com/526142333',
      text: 'followers',
      count: 8
    }
  ]}
/>

