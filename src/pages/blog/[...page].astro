---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import Paginator from '@astro-pure/pages/Paginator.astro'
import Icon from '@astro-pure/user/Icon.astro'

import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreview from '@/components/pure/PostPreview.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(collections).map(([tag]) => tag)
  const collectionsCount = collections.length
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, collectionsCount }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
}

const { page, uniqueTags, collectionsCount } = Astro.props

const meta = {
  description: '技术实践、问题解法和生活中的发现。Huazzi 的全部文章。',
  title: '文章'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← 上一页`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `下一页 →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <main class='writing-page'>
    <div id='content-header' class='animate'>
      <p class='eyebrow'>THE JOURNAL / 文章</p>
      <h1 class='mt-3 mb-4'>探索的过程，都在这里。</h1>
      <p class='text-sm text-muted-foreground'>写代码，解问题，也记下偶然的灵感。</p>
    </div>
    {
      page.data.length === 0 ? (
        <p>第一篇记录正在路上。</p>
      ) : (
        <div class='writing-grid'>
          <section aria-label='Blog posts list' class='animate' id='content'>
            {/* header */}
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                第 {page.currentPage} 页 · 共 {collectionsCount} 篇文章
              </span>
              <a href='/archives' data-astro-prefetch>
                按年份浏览 →
              </a>
            </div>
            {/* posts */}
            <ul class='flex flex-col text-start'>
              {page.data.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
            <Paginator {...paginationProps} />
          </section>

          {/* sidebar */}
          {!!uniqueTags.length && (
            <aside class='animate writing-topics' id='sidebar'>
              <h2 class='mb-4 flex items-center text-lg font-medium'>
                <Icon name='tag-2' class='me-2' />
                按主题探索
              </h2>
              <ul class='text-bgColor flex flex-wrap gap-2'>
                {uniqueTags.slice(0, 20).map((tag) => (
                  <li>
                    <a class='writing-tag' href={`/tags/${encodeURIComponent(tag)}`}>
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
              <span class='mt-4 block sm:text-end'>
                <a href='/tags' data-astro-prefetch>
                  查看全部 →
                </a>
              </span>
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>

<style>
  .writing-page {
    padding-top: 24px;
  }
  .writing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 48px;
    border-top: 1px solid hsl(var(--border));
    padding-top: 30px;
  }
  .writing-topics {
    position: sticky;
    top: 110px;
    align-self: start;
    padding: 22px;
    background: hsl(var(--muted) / 0.55);
    border-radius: 14px;
    border: 1px solid hsl(var(--border));
  }
  .writing-topics h2 {
    font-size: 14px;
  }
  .writing-tag {
    display: inline-block;
    border: 1px solid hsl(var(--border));
    border-radius: 6px;
    padding: 5px 8px;
    background: hsl(var(--card));
    font-size: 11px;
  }
  .writing-topics > span {
    font-size: 12px;
  }
  @media (max-width: 767px) {
    .writing-page {
      padding-top: 8px;
    }
    .writing-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .writing-topics {
      position: static;
    }
  }
</style>
