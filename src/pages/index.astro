---
import { Image } from 'astro:assets'
import Icon from '@astro-pure/user/Icon.astro'

import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import FieldNote from '@/components/home/FieldNote.astro'
import PostPreview from '@/components/pure/PostPreview.astro'
import config from '@/site-config'

const allPosts = sortMDByDate(await getBlogCollection()).filter(
  (post) => post.collection === 'blog'
)
const latestPost = allPosts[0]
const topics = getUniqueTagsWithCount(allPosts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath]) throw new Error(`Avatar not found: ${imagePath}`)
---

<PageLayout
  meta={{
    title: '首页',
    description: 'Huazzi 的个人博客。记录技术实践、解决问题的过程，以及生活中的一些发现。'
  }}
>
  <main class='home'>
    <section class='home-hero animate' id='content-header' aria-labelledby='home-title'>
      <div class='hero-copy'>
        <p class='eyebrow hero-eyebrow'><span></span> A developer's personal corner</p>
        <div class='hello'>
          <Image
            src={images[imagePath]()}
            alt={config.logo.alt || 'Huazzi 的头像'}
            width={40}
            height={40}
            class='avatar'
            loading='eager'
          />
          <span
            >你好，我是 <strong>{config.author}</strong><span class='hello-wave' aria-hidden='true'
              >↗</span
            ></span
          >
        </div>
        <h1 id='home-title'>
          记录折腾，<br />也记录<span class='hero-accent'
            >灵感<svg viewBox='0 0 170 12' aria-hidden='true'><path d='M3 8Q80 0 167 7'></path></svg
            ></span
          >。
        </h1>
        <p class='hero-description'>
          在代码里探索，在生活中发现。<br />把遇到的问题、学到的东西，认真记下来。
        </p>
        <div class='hero-actions'>
          <a class='primary-link' href='/blog'>翻开我的笔记 <span aria-hidden='true'>↗</span></a>
          <a class='section-link' href='/about'
            >关于我 <span class='arrow' aria-hidden='true'>→</span></a
          >
        </div>
        <div class='hero-footnote'>
          <span class='status-dot'></span> 保持好奇，持续构建 <span class='footnote-divider'>/</span
          ><a href='https://github.com/Huazzi' target='_blank' rel='noopener noreferrer'
            ><Icon name='github' class='size-4' /> GitHub <span aria-hidden='true'>↗</span></a
          >
        </div>
      </div>
      {latestPost && <FieldNote post={latestPost} />}
    </section>

    <div class='home-body animate' id='content'>
      <section class='recent-posts' aria-labelledby='recent-title'>
        <div class='section-heading'>
          <div>
            <p class='eyebrow'>THE JOURNAL</p><h2 id='recent-title'>
              最近写下<span class='section-count'>{String(allPosts.length).padStart(2, '0')}</span>
            </h2>
          </div>
          <a class='section-link' href='/archives'
            >时间归档 <span class='arrow' aria-hidden='true'>↗</span></a
          >
        </div>
        <p class='section-description'>一些实践，一些解法，一些值得留下的瞬间。</p>
        <ul class='post-list'>{allPosts.slice(0, 6).map((post) => <PostPreview {post} />)}</ul>
        <a class='all-posts' href='/blog'
          >浏览全部 {allPosts.length} 篇文章 <span aria-hidden='true'>→</span></a
        >
      </section>

      <aside class='home-aside' aria-label='探索博客'>
        <section class='about-card'>
          <p class='eyebrow'>BEHIND THE WORDS</p>
          <h2>代码之外<span aria-hidden='true'>↗</span></h2>
          <p>喜欢编程，也喜欢跑步、<br />吹晚风和看日落。</p>
          <div class='about-divider'></div>
          <p class='education'>郑州大学 · 计算机科学与技术<br /><span>2022 — 2026</span></p>
          <a class='section-link' href='/about'
            >认识一下 <span class='arrow' aria-hidden='true'>→</span></a
          >
        </section>
        <section class='topics-section'>
          <div class='aside-heading'>
            <h2>循着兴趣</h2><a href='/tags' aria-label='查看全部标签'>↗</a>
          </div>
          <div class='topic-list'>
            {
              topics.map(([tag, count]) => (
                <a href={`/tags/${encodeURIComponent(tag)}`}>
                  <>
                    <span>{tag}</span>
                    <span>{count}</span>
                  </>
                </a>
              ))
            }
          </div>
        </section>
        <a class='rss-card' href='/rss.xml'
          ><Icon name='rss' class='size-5' /><span
            ><strong>让新文章来找你</strong><small>通过 RSS，慢慢读。</small></span
          ><span aria-hidden='true'>↗</span></a
        >
      </aside>
    </div>

    <section class='toolbox' aria-labelledby='toolbox-title'>
      <div><p class='eyebrow'>MY TOOLBOX</p><h2 id='toolbox-title'>想法落地的工具箱</h2></div>
      <div class='toolbox-items'>
        {
          ['Java', 'Spring Boot', 'Python', 'Astro', 'Git', 'Linux', 'Docker'].map((tool) => (
            <span>{tool}</span>
          ))
        }
      </div>
      <a class='section-link' href='/about#tools'
        >全部工具 <span class='arrow' aria-hidden='true'>↗</span></a
      >
    </section>
  </main>
</PageLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 4rem;
    padding: 28px 0 76px;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
  }
  .hero-eyebrow > span {
    width: 18px;
    height: 1px;
    background: hsl(var(--primary));
  }
  .hello {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    font-size: 14px;
    color: hsl(var(--muted-foreground));
  }
  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    padding: 3px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
  }
  .hello strong {
    font-weight: 500;
    color: hsl(var(--foreground));
  }
  .hello-wave {
    display: inline-block;
    margin-left: 8px;
    color: hsl(var(--primary));
  }
  h1 {
    font-size: clamp(2.6rem, 4.5vw, 3.6rem);
    line-height: 1.4;
    letter-spacing: -0.055em;
    margin: 20px 0;
    font-weight: 600;
  }
  .hero-accent {
    position: relative;
    color: hsl(var(--primary));
    white-space: nowrap;
  }
  .hero-accent svg {
    position: absolute;
    width: 100%;
    height: 12px;
    bottom: -5px;
    left: 0;
    fill: none;
    stroke: hsl(var(--primary) / 0.4);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .hero-description {
    color: hsl(var(--muted-foreground));
    font-size: 15px;
    line-height: 2;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 30px;
  }
  .primary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    border-radius: 10px;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    padding: 12px 20px;
    font-size: 13px;
    transition:
      transform 200ms var(--ease-out),
      background 200ms,
      box-shadow 200ms;
  }
  .primary-link:hover {
    background: hsl(var(--primary));
    color: hsl(var(--card));
    transform: translateY(-2px);
    box-shadow: 0 5px 16px hsl(var(--primary) / 0.15);
  }
  .primary-link span {
    font-size: 18px;
  }
  .hero-footnote {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 30px;
    color: hsl(var(--muted-foreground));
    font-size: 10px;
  }
  .status-dot {
    width: 5px;
    height: 5px;
    background: hsl(var(--primary));
    border-radius: 50%;
  }
  .footnote-divider {
    color: hsl(var(--border));
    margin-inline: 6px;
  }
  .hero-footnote a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .home-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 64px;
    padding-top: 42px;
    border-top: 1px solid hsl(var(--border));
  }
  .recent-posts {
    min-width: 0;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }
  .section-heading h2 {
    margin-top: 8px;
    font-size: 25px;
  }
  .section-count {
    vertical-align: middle;
    color: hsl(var(--muted-foreground));
    font: 10px var(--code-font);
    margin-left: 12px;
    padding: 3px 6px;
    border: 1px solid hsl(var(--border));
    border-radius: 5px;
  }
  .section-description {
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    margin: 12px 0 20px;
  }
  .post-list {
    display: flex;
    flex-direction: column;
  }
  .all-posts {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid hsl(var(--border));
    border-radius: 10px;
    padding: 11px 16px;
    margin-top: 24px;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    transition:
      background 180ms,
      border-color 180ms;
  }
  .all-posts:hover {
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.35);
    background: hsl(var(--card));
  }
  .about-card {
    padding: 24px;
    background: hsl(var(--muted) / 0.65);
    border: 1px solid hsl(var(--border));
    border-radius: 14px;
  }
  .about-card .eyebrow {
    font-size: 9px;
  }
  .about-card h2 {
    display: flex;
    justify-content: space-between;
    font-size: 20px;
    margin: 13px 0;
  }
  .about-card h2 span {
    color: hsl(var(--primary));
    font-size: 17px;
    font-weight: 400;
  }
  .about-card p:not(.eyebrow) {
    font-size: 12px;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }
  .about-divider {
    height: 1px;
    background: hsl(var(--border));
    margin: 20px 0;
  }
  .about-card .education {
    font-size: 11px !important;
  }
  .education span {
    font-family: var(--code-font);
    font-size: 10px;
  }
  .about-card .section-link {
    margin-top: 18px;
    font-size: 12px;
  }
  .topics-section {
    margin-top: 30px;
  }
  .aside-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .aside-heading h2 {
    font-size: 14px;
  }
  .aside-heading a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: hsl(var(--muted-foreground));
  }
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .topic-list a {
    display: flex;
    gap: 9px;
    align-items: center;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 11px;
    transition:
      border-color 180ms,
      color 180ms;
  }
  .topic-list a:hover {
    border-color: hsl(var(--primary) / 0.4);
  }
  .topic-list a > span:last-child {
    font: 9px var(--code-font);
    color: hsl(var(--muted-foreground));
  }
  .rss-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 25px;
    margin-top: 28px;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
  }
  .rss-card > span:first-of-type {
    flex: 1;
  }
  .rss-card strong {
    display: block;
    color: hsl(var(--foreground));
    font-size: 12px;
    font-weight: 500;
  }
  .rss-card small {
    display: block;
    font-size: 11px;
    margin-top: 4px;
  }
  .toolbox {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding: 28px 0;
    border-block: 1px solid hsl(var(--border));
  }
  .toolbox .eyebrow {
    font-size: 9px;
  }
  .toolbox h2 {
    margin-top: 6px;
    font-size: 14px;
    white-space: nowrap;
  }
  .toolbox-items {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    color: hsl(var(--muted-foreground));
    font: 11px var(--code-font);
  }
  .toolbox > a {
    flex: none;
    font-size: 11px;
  }
  @media (max-width: 1023px) {
    .home-hero {
      gap: 20px;
    }
    .home-body {
      gap: 32px;
      grid-template-columns: minmax(0, 1fr) 230px;
    }
    .toolbox {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 767px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 10px 0 40px;
    }
    h1 {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }
    .hello {
      margin-top: 24px;
    }
    .home-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 30px;
    }
    .home-aside {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .topics-section {
      margin-top: 0;
    }
    .rss-card {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .toolbox {
      margin-top: 40px;
    }
    .toolbox-items {
      order: 3;
      width: 100%;
    }
  }
  @media (max-width: 420px) {
    .home-aside {
      grid-template-columns: 1fr;
    }
    .rss-card {
      grid-column: auto;
    }
    .section-heading > a {
      font-size: 12px;
    }
    .hero-actions {
      gap: 20px;
    }
  }
</style>
