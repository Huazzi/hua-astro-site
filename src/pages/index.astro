---
import { Image } from 'astro:assets'
import Quote from '@astro-pure/advanced/Quote.astro'
import Button from '@astro-pure/user/Button.astro'
import Card from '@astro-pure/user/Card.astro'
import Icon from '@astro-pure/user/Icon.astro'
import Label from '@astro-pure/user/Label.astro'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import FieldNote from '@/components/home/FieldNote.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import PostPreview from '@/components/pure/PostPreview.astro'
import config from '@/site-config'

const languages = ['Java', 'C', 'Python', 'C#']
const frontend = ['JavaScript', 'Vite', 'Webpack', 'Astro']
const backend = ['SpringBoot', 'MySQL', 'Redis']
const developmentTools = ['VSCode', 'Git', 'Linux', 'Docker', 'Nginx']

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='w-full'>
    <section class='home-hero animate' id='content-header'>
      <div class='hero-copy'>
        <p class='eyebrow'>HUAZZI / PERSONAL NOTES</p>
        <div class='flex items-center gap-4'>
          <Image
            src={images[imagePath]()}
            alt={config.logo.alt || 'Huazzi 的头像'}
            class='h-14 w-14 rounded-full border border-border p-1'
            loading='eager'
            fetchpriority='high'
          />
          <span class='text-sm text-muted-foreground'>你好，我是 {config.author}</span>
        </div>
        <h1>把有价值的发现，<br /><em>认真记下来。</em></h1>
        <p class='hero-description'>一名正在成长的开发者。在这里记录技术实践、遇到的问题，以及生活中的一些发现。</p>
        <div class='hero-actions'>
          <a class='hero-link' href='/blog'>阅读文章 <span aria-hidden='true'>↗</span></a>
          <a class='text-link' href='/about'>了解我 <span aria-hidden='true'>→</span></a>
        </div>
        <div class='hero-meta'>
          <Label title='China'><Icon name='location' class='size-5' slot='icon' /></Label>
          <Label title='Github' as='a' href='https://github.com/Huazzi' target='_blank' rel='noopener noreferrer'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
      <FieldNote />
    </section>
    <div id='content' class='animate mx-auto flex max-w-5xl flex-col gap-y-16'>
      {
        allPostsByDate.length > 0 && (
          <Section title='最近写下' class='home-posts'>
            <p class='text-sm text-muted-foreground'>从最新的问题开始，翻阅最近的记录。</p>
            <ul class='flex flex-col gap-y-2'>
              {allPostsByDate.map((p) => <PostPreview post={p} />)}
            </ul>
            <Button title='查看所有文章' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }
      <Section title='关于我'>
        <p class='text-muted-foreground'>喜欢编程、跑步、吹晚风和看日落。</p>
        <Button title='更多关于我' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      {
