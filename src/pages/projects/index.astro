---
import { Image } from 'astro:assets'

import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import KeyIcon from '@/assets/icons/key.svg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'others', text: 'Others' },
  // { depth: 2, slug: 'gpg-signature', text: 'GPG Signature' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>WakaTime Stats:</p>
  <p>
    <a href='https://wakatime.com/@Huazzi' target='_blank'>
      <img
        src='https://wakatime.com/share/@Huazzi/2ca69262-d085-4c4f-b6b3-a56de85df641.svg'
        alt='WakaTime Stats'
      />
    </a>
  </p>
  <figure>
    <embed src='https://wakatime.com/share/@Huazzi/141de815-b1d1-4374-93a6-ba07d87e9dd3.svg' />
  </figure>

  <!-- <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/Huazzi'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p> -->
  <p>如果你认为我的工作很有用或有趣，您可以捐赠以支持我的工作，或联系我讨论项目。</p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '贰货来了',
        description: '一款专为高校学生打造的新一代智能化校园二手交易平台',
        links: [
          { type: 'github', href: 'https://github.com/Huazzi/Campus-Second-Hand-Platform' },
          { type: 'site', href: 'https://github.com/Huazzi/Campus-Second-Hand-Platform' },
          {
            type: 'doc',
            href: 'https://github.com/Huazzi/Campus-Second-Hand-Platform/blob/main/README.md'
          }
        ]
      },
      {
        name: 'One Monokai Pro',
        description: 'A beautiful dark theme for VS Code inspired by One Monokai color scheme',
        links: [
          { type: 'github', href: 'https://github.com/Huazzi/vscode-one-monokai-pro' },
          { type: 'site', href: 'https://github.com/Huazzi/vscode-one-monokai-pro' },
          {
            type: 'doc',
            href: 'https://github.com/Huazzi/vscode-one-monokai-pro/blob/main/README.md'
          }
        ]
      }
    ]}
  />
