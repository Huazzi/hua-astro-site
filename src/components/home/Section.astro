---
import { cn } from 'astro-pure/utils'

const { class: className, title } = Astro.props
---

<section class={cn('flex flex-col gap-y-5 border-t border-border pt-8 md:flex-row md:gap-y-0', className)}>
  <div class='text-2xl md:min-w-44'>
    <h2>{title}</h2>
  </div>
  <div class='flex flex-1 flex-col gap-y-4'>
    <slot />
  </div>
</section>
