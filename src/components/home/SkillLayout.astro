---
type Props = {
  title: string
  skills: string[]
}

const { title, skills } = Astro.props
---

<div class='flex flex-col gap-y-2 md:flex-row md:gap-x-5 md:gap-y-0'>
  <h3 class='md:w-1/5'>{title}</h3>
  <div class='flex flex-row flex-wrap gap-x-2 gap-y-2 md:w-4/5'>
    {skills.map((skill: string) => <span class='skill-chip'>{skill}</span>)}
  </div>
</div>

<style>
  .skill-chip {
    padding: 0.3rem 0.85rem;
    border: 1px solid hsl(var(--border));
    border-radius: 22px 15px 19px 13px / 15px 21px 14px 20px;
    background: hsl(var(--card));
    font-size: 0.875rem;
  }
</style>
