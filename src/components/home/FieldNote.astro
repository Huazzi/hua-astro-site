---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '@astro-pure/user/FormattedDate.astro'

interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
---

<div class='note-stage'>
  <span class='stage-caption eyebrow'>A little progress, every day.</span>
  <div class='note-stack'>
    <div class='back-sheet sheet-two' aria-hidden='true'></div>
    <div class='back-sheet sheet-one' aria-hidden='true'><span>THOUGHTS & DISCOVERIES</span></div>
    <a class='note-page' href={`/blog/${post.id}`} data-astro-prefetch>
      <div class='note-topline'>
        <span class='note-tab'>最新笔记</span><span class='note-index'>FIELD NOTES</span>
      </div>
      <div class='note-glyph' aria-hidden='true'>[<span>h.</span>]</div>
      <p class='note-topic'>{post.data.tags.slice(0, 2).join(' / ') || '技术与生活'}</p>
      <h2>{post.data.title}</h2>
      <p class='note-description'>{post.data.description}</p>
      <div class='note-bottom'>
        <FormattedDate date={post.data.updatedDate ?? post.data.publishDate} /><span
          class='note-open'
          aria-hidden='true'>↗</span
        >
      </div>
    </a>
  </div>
  <span class='note-annotation'>每一次折腾，都有一点收获。<span aria-hidden='true'>↗</span></span>
</div>

<style>
  .note-stage {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 460px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px 30px;
    background-image: radial-gradient(
      hsl(var(--muted-foreground) / 0.18) 0.75px,
      transparent 0.75px
    );
    background-size: 18px 18px;
    border-radius: 50%;
  }
  .stage-caption {
    margin-bottom: 38px;
    font-size: 9px;
    letter-spacing: 0.1em;
  }
  .note-stack {
    position: relative;
    width: 100%;
    max-width: 340px;
    perspective: 900px;
  }
  .back-sheet {
    position: absolute;
    inset: 0;
    border: 1px solid hsl(var(--border));
    border-radius: 14px;
    transition: transform 500ms var(--ease-out);
  }
  .sheet-two {
    background: hsl(var(--primary) / 0.13);
    transform: rotate(-9deg) translate(-8px, -2px);
  }
  .sheet-one {
    background: hsl(var(--card));
    transform: rotate(5deg) translate(12px, 3px);
  }
  .sheet-one span {
    position: absolute;
    right: 20px;
    bottom: 14px;
    font: 8px var(--code-font);
    color: hsl(var(--muted-foreground));
  }
  .note-page {
    position: relative;
    display: block;
    padding: 24px 28px 18px;
    border: 1px solid hsl(var(--border));
    border-radius: 14px;
    background: hsl(var(--card));
    box-shadow: 0 16px 45px -16px hsl(218 42% 15% / 0.18);
    transform: rotate(-3deg);
    transition:
      transform 500ms var(--ease-out),
      box-shadow 500ms;
  }
  .note-stack:hover .note-page,
  .note-stack:focus-within .note-page {
    transform: rotate(0) translateY(-8px);
    box-shadow: 0 25px 50px -18px hsl(var(--primary) / 0.25);
  }
  .note-stack:hover .sheet-two,
  .note-stack:focus-within .sheet-two {
    transform: rotate(-12deg) translate(-10px, 0);
  }
  .note-topline,
  .note-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .note-tab {
    font-size: 10px;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.08);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .note-index {
    color: hsl(var(--muted-foreground));
    font: 9px var(--code-font);
    letter-spacing: 0.1em;
  }
  .note-glyph {
    margin: 24px 0 18px;
    font-family: var(--code-font);
    font-size: 44px;
    line-height: 1;
    color: hsl(var(--primary) / 0.3);
    letter-spacing: 0.1em;
  }
  .note-glyph span {
    color: hsl(var(--primary));
    letter-spacing: -0.1em;
    padding-right: 8px;
  }
  .note-topic {
    font: 10px var(--code-font);
    color: hsl(var(--muted-foreground));
  }
  h2 {
    margin: 10px 0;
    color: hsl(var(--foreground));
    font-size: 21px;
    line-height: 1.55;
    letter-spacing: -0.03em;
  }
  .note-description {
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    line-height: 1.9;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .note-bottom {
    margin-top: 24px;
    padding-top: 15px;
    border-top: 1px solid hsl(var(--border));
    font: 10px var(--code-font);
    color: hsl(var(--muted-foreground));
  }
  .note-open {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--primary));
    font-size: 19px;
  }
  .note-annotation {
    margin-top: 33px;
    color: hsl(var(--muted-foreground));
    font-size: 11px;
  }
  .note-annotation span {
    display: inline-block;
    font-size: 20px;
    margin-left: 16px;
    transform: rotate(-20deg);
  }
  @media (max-width: 767px) {
    .note-stage {
      min-height: 400px;
      padding: 20px 28px;
    }
    .stage-caption {
      margin-bottom: 28px;
    }
    .note-stack {
      max-width: 330px;
    }
  }
</style>
