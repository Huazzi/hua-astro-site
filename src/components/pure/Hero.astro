---
import { Image } from 'astro:assets'
import type { InferEntrySchema } from 'astro:content'
import FormattedDate from '@astro-pure/user/FormattedDate.astro'

interface Props {
  data: InferEntrySchema<'blog'>
  remarkPluginFrontmatter: Record<string, unknown>
}
const {
  data: { title, description, draft, heroImage, publishDate, updatedDate, tags },
  remarkPluginFrontmatter
} = Astro.props
---

<div class='article-info'>
  <div class='article-tags'>
    {
      tags.map((tag: string) => (
        <a data-pagefind-filter='tag' href={`/tags/${encodeURIComponent(tag)}`}>
          #{tag}
        </a>
      ))
    }
  </div>
  {draft && <span class='text-red-500'>草稿</span>}
  <h1>{title}</h1>
  <p class='article-description'>{description}</p>
  <div class='article-metadata'>
    <span>发布于 <FormattedDate date={publishDate} /></span>
    <span>{remarkPluginFrontmatter.minutesRead}</span>
    {
      updatedDate && (
        <span>
          更新于 <FormattedDate date={updatedDate} />
        </span>
      )
    }
  </div>
  <slot name='description' />
</div>
{
  heroImage && (
    <Image
      {...heroImage}
      alt={heroImage.alt || title}
      class='cover-image'
      fetchpriority='high'
      loading='eager'
    />
  )
}

<style>
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-bottom: 18px;
    color: hsl(var(--primary));
    font-size: 12px;
  }
  h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    line-height: 1.45;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .article-description {
    color: hsl(var(--muted-foreground));
    font-size: 15px;
    line-height: 1.9;
    margin-top: 20px;
  }
  .article-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 24px;
    padding-block: 18px;
    border-block: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 11px;
  }
  .cover-image {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: contain;
    border-radius: 12px;
    margin-top: 28px;
  }
</style>
