---
import Icon from '@astro-pure/user/Icon.astro'
import config from 'virtual:config'

const footerConf = config.footer
const social = footerConf.social || []
---

<footer class='site-footer'>
  <div class='footer-top'>
    <a class='footer-signature' href='/'>{config.author}<span>.</span></a><p>
      保持好奇，下次见。
    </p><a class='back-top' href='#main-content'>回到顶部 <span aria-hidden='true'>↑</span></a>
  </div>
  <div class='footer-bottom'>
    <div class='footer-meta'>
      <span>{config.footer.year} {config.author}</span>{
        footerConf.links?.map(({ title, link }) => (
          <a href={link}>{title === 'Site Policy' ? '站点政策' : title}</a>
        ))
      }
      {
        footerConf.credits && (
          <span class='credits'>
            Built with{' '}
            <a href='https://github.com/withastro/astro' target='_blank' rel='noopener noreferrer'>
              Astro
            </a>{' '}
            &{' '}
            <a
              href='https://github.com/cworld1/astro-theme-pure'
              target='_blank'
              rel='noopener noreferrer'
            >
              Pure
            </a>
          </span>
        )
      }
    </div>
    <div class='footer-social'>
      {
        social.map(({ label, href, icon }) => (
          <a {href} rel='me' aria-label={label}>
            <>
              <Icon name={icon} class='size-4' />
              <span>{label}</span>
            </>
          </a>
        ))
      }
    </div>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: 70px;
    padding-bottom: 28px;
  }
  .footer-top {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 26px;
  }
  .footer-signature {
    font-size: 22px;
    letter-spacing: -0.07em;
    font-weight: 600;
  }
  .footer-signature span {
    color: hsl(var(--primary));
  }
  .footer-top p {
    font-family: 'Songti SC', SimSun, serif;
    font-size: 14px;
    color: hsl(var(--muted-foreground));
  }
  .back-top {
    margin-left: auto;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }
  .back-top span {
    display: inline-block;
    margin-left: 10px;
    transition: transform 200ms;
  }
  .back-top:hover span {
    transform: translateY(-3px);
  }
  .footer-bottom {
    border-top: 1px solid hsl(var(--border));
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: 10px;
    color: hsl(var(--muted-foreground));
  }
  .footer-meta,
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
  }
  .credits {
    font-size: 10px;
  }
  @media (max-width: 640px) {
    .site-footer {
      margin-top: 48px;
    }
    .footer-top {
      gap: 12px;
    }
    .footer-top p {
      font-size: 10px;
    }
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
    .credits {
      flex-basis: 100%;
    }
  }
</style>
