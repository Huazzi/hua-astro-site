---
import Icon from '@astro-pure/user/Icon.astro'
import config from 'virtual:config'

const pathname = Astro.url.pathname
const isCurrent = (link: string) => pathname === link || pathname.startsWith(`${link}/`)
---

<header-component class='site-header' role='banner'>
  <a class='brand' href='/' aria-label='Huazzi，返回首页'>
    <span class='brand-symbol' aria-hidden='true'>h<span>.</span></span>
    <span>{config.author}<span class='brand-caption'> / 日常与代码</span></span>
  </a>
  <nav id='headerExpandContent' aria-label='主导航'>
    <a href='/' aria-current={pathname === '/' ? 'page' : undefined}>首页</a>
    {
      config.header.menu.map((item) => (
        <a
          href={item.link}
          aria-current={isCurrent(item.link) ? 'page' : undefined}
          data-astro-prefetch
        >
          {item.title}
        </a>
      ))
    }
  </nav>
  <div class='header-tools'>
    <a
      class='icon-button search-link'
      href='/search'
      aria-label='搜索文章'
      title='搜索文章（⌘ / Ctrl K）'
    >
      <Icon name='search' class='size-4' /><kbd aria-hidden='true'>⌘ K</kbd>
    </a>
    <span class='tool-divider' aria-hidden='true'></span>
    <button id='toggleDarkMode' class='icon-button' aria-label='切换主题' title='切换主题'>
      <Icon class='theme-sun size-5' name='sun' />
      <Icon class='theme-moon size-5' name='moon' />
    </button>
    <button
      id='toggleMenu'
      class='icon-button menu-button'
      aria-controls='headerExpandContent'
      aria-expanded='false'
      aria-label='打开导航'
    >
      <span class='menu-lines' aria-hidden='true'></span>
    </button>
  </div>
</header-component>

<script>
  import { setTheme } from 'astro-pure/utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      const menu = this.querySelector<HTMLButtonElement>('#toggleMenu')!
      const themeButton = this.querySelector<HTMLButtonElement>('#toggleDarkMode')!
      const closeMenu = (focus = false) => {
        this.classList.remove('expanded')
        menu.setAttribute('aria-expanded', 'false')
        menu.setAttribute('aria-label', '打开导航')
        if (focus) menu.focus()
      }
      const updateThemeLabel = () => {
        const dark = document.documentElement.classList.contains('dark')
        themeButton.setAttribute('aria-label', dark ? '切换为浅色模式' : '切换为深色模式')
        themeButton.title = dark ? '切换为浅色模式' : '切换为深色模式'
      }
      updateThemeLabel()
      const observer = new MutationObserver(updateThemeLabel)
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
      themeButton.addEventListener('click', () => {
        setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark', true)
      })
      menu.addEventListener('click', () => {
        const expanded = this.classList.toggle('expanded')
        menu.setAttribute('aria-expanded', String(expanded))
        menu.setAttribute('aria-label', expanded ? '关闭导航' : '打开导航')
      })
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !this.contains(event.target)) closeMenu()
      })
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.classList.contains('expanded')) closeMenu(true)
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault()
          window.location.assign('/search')
        }
      })
      this.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && !this.contains(event.relatedTarget)) closeMenu()
      })
      window.matchMedia('(min-width: 768px)').addEventListener('change', () => closeMenu())
      const updateScroll = () => this.classList.toggle('scrolled', window.scrollY > 16)
      updateScroll()
      window.addEventListener('scroll', updateScroll, { passive: true })
    }
  }
  customElements.define('header-component', HeaderComponent)
</script>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
    margin: 16px -16px 48px;
    padding: 8px 16px;
    border: 1px solid transparent;
    border-radius: 18px;
    transition:
      background 220ms,
      box-shadow 220ms,
      border-color 220ms;
  }
  .site-header.scrolled,
  .site-header.expanded {
    background: hsl(var(--background) / 0.92);
    border-color: hsl(var(--border));
    backdrop-filter: blur(18px);
    box-shadow: 0 8px 32px hsl(var(--foreground) / 0.05);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .brand-symbol {
    display: grid;
    place-content: center;
    grid-auto-flow: column;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.08em;
  }
  .brand-symbol span {
    color: #93afff;
  }
  .brand-caption {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: hsl(var(--muted-foreground));
    margin-left: 4px;
  }
  nav,
  .header-tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  nav a {
    position: relative;
    padding: 8px 13px;
    border-radius: 9px;
    color: hsl(var(--muted-foreground));
    font-size: 0.85rem;
  }
  nav a:hover {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  nav a[aria-current='page'] {
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--primary));
  }
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 10px;
    color: hsl(var(--muted-foreground));
    transition:
      background 180ms,
      color 180ms;
  }
  .icon-button:hover {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  kbd {
    border: 1px solid hsl(var(--border));
    border-radius: 4px;
    font-family: var(--code-font);
    font-size: 10px;
    line-height: 1.7;
    padding: 0 4px;
  }
  .tool-divider {
    height: 16px;
    width: 1px;
    background: hsl(var(--border));
    margin: 0 5px;
  }
  .theme-moon,
  .menu-button {
    display: none;
  }
  :global(.dark) .theme-moon {
    display: block;
  }
  :global(.dark) .theme-sun {
    display: none;
  }
  @media (max-width: 1023px) {
    .brand-caption {
      display: none;
    }
    nav a {
      padding-inline: 10px;
    }
  }
  @media (max-width: 767px) {
    .site-header {
      min-height: 60px;
      margin: 8px -8px 30px;
      padding: 6px 8px;
      top: 8px;
    }
    .menu-button {
      display: inline-flex;
    }
    kbd,
    .tool-divider {
      display: none;
    }
    nav {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      padding: 10px;
      display: grid;
      background: hsl(var(--card));
      border: 1px solid hsl(var(--border));
      border-radius: 14px;
      box-shadow: 0 16px 40px hsl(var(--foreground) / 0.08);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 180ms,
        transform 180ms,
        visibility 180ms;
    }
    .expanded nav {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }
    nav a {
      padding: 11px 15px;
    }
    .menu-lines,
    .menu-lines::after {
      width: 18px;
      height: 1.5px;
      background: currentColor;
      display: block;
      transition: transform 180ms;
    }
    .menu-lines {
      transform: translateY(-3px);
    }
    .menu-lines::after {
      content: '';
      transform: translateY(6px);
    }
    .expanded .menu-lines {
      transform: rotate(45deg);
    }
    .expanded .menu-lines::after {
      transform: rotate(-90deg);
    }
  }
</style>
