---
import { Image } from 'astro:assets'
import { render, type CollectionEntry, type CollectionKey } from 'astro:content'
import Button from '@astro-pure/user/Button.astro'
import FormattedDate from '@astro-pure/user/FormattedDate.astro'
import Icon from '@astro-pure/user/Icon.astro'

import { cn } from 'astro-pure/utils'

type Props<T extends CollectionKey> = {
  post: CollectionEntry<T>
  detailed?: boolean
  class?: string
}

const { post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
---

<li
  class={cn('post-preview', detailed && 'detailed', className)}
  style={detailed && data.heroImage?.color
    ? `--preview-highlight-bg:hsl(from ${data.heroImage.color} h s l/12%)`
    : undefined}
>
  {
    detailed && data.heroImage && (
      <Image
        alt={data.heroImage.alt || data.title}
        class='cover-image'
        {...data.heroImage}
        loading='lazy'
      />
    )
  }
  <div class='preview-body'>
    <FormattedDate class='preview-date' date={postDate} />
    <a class='preview-title' href={`/blog/${id}`} data-astro-prefetch>
      <span>
        {data.draft && <span class='text-red-500'>(Draft) </span>}{data.title}
      </span>
      <span class='preview-arrow' aria-hidden='true'>↗</span>
    </a>
    {
      detailed && (
        <>
          <p class='preview-description'>{data.description}</p>
          <div class='preview-meta'>
            <span class='flex items-center gap-1'>
              <Icon name='time' class='size-4' />
              {remarkPluginFrontmatter.minutesRead}
            </span>
            {data.language && (
              <span class='flex items-center gap-1'>
                <Icon name='earth' class='size-4' />
                {data.language}
              </span>
            )}
          </div>
          {data.tags.length > 0 && (
            <ul class='tag-list'>
              {data.tags.map((tag: string) => (
                <li>
                  <Button as='a' title={tag} href={`/tags/${tag}`} variant='pill' />
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }
  </div>

  <style>
    .post-preview {
      position: relative;
      display: flex;
      overflow: hidden;
      border: 1px solid hsl(var(--border));
      border-radius: var(--organic-radius);
      background: hsl(var(--card));
      transition:
        background 0.5s ease,
        transform 0.5s ease;
    }
    .post-preview:hover,
    .post-preview:focus-within {
      background: var(--preview-highlight-bg, hsl(var(--muted)));
      transform: translateY(2px);
    }
    .preview-body {
      position: relative;
      z-index: 1;
      display: flex;
      min-width: 0;
      width: 100%;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1.15rem 1.35rem;
    }
    .preview-date,
    .preview-meta {
      color: hsl(var(--muted-foreground));
      font-size: 0.78rem;
      font-variant-numeric: tabular-nums;
    }
    .preview-title {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-family: var(--display-font);
      font-size: 1.12rem;
      line-height: 1.45;
    }
    .preview-title:hover {
      color: hsl(var(--primary));
    }
    .preview-arrow {
      flex: none;
      color: hsl(var(--primary));
    }
    .detailed {
      min-height: 220px;
    }
    .detailed .preview-body {
      padding: 1.5rem 1.75rem;
    }
    .detailed .preview-title {
      font-size: clamp(1.3rem, 2vw, 1.65rem);
    }
    .preview-description {
      max-width: 38rem;
      margin: 0;
      color: hsl(var(--muted-foreground));
      font-size: 0.9rem;
      line-height: 1.75;
    }
    .preview-meta,
    .tag-list {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.65rem;
    }
    .tag-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .cover-image {
      position: absolute;
      inset: 0 0 0 auto;
      width: 45%;
      height: 100%;
      object-fit: cover;
      opacity: 0.24;
      mask-image: linear-gradient(to right, transparent, black);
    }
    @media (max-width: 640px) {
      .detailed .preview-body {
        padding: 1.2rem;
      }
      .cover-image {
        width: 65%;
        opacity: 0.13;
      }
    }
  </style>
</li>
