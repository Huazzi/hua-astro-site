---
import { type ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Icon from '@astro-pure/user/Icon.astro'

import type { IconsType } from 'astro-pure/types'
import { cn } from 'astro-pure/utils'

interface Props {
  class?: string
  methods: {
    name: string
    icon: IconsType
    image: ImageMetadata
  }[]
}

const { class: className, methods, ...props } = Astro.props
---

<div class={cn('flex flex-col justify-center gap-4 sm:flex-row', className)} {...props}>
  {
    methods.map((item) => (
      <button
        type='button'
        class='sponsorship-card relative justify-center overflow-hidden rounded-xl border bg-white p-0'
        aria-label={`${item.name} 赞赏码（点击保持显示）`}
        aria-pressed='false'
      >
        <div class='sponsorship-card-icon pointer-events-none absolute bottom-0 end-0 start-0 top-0 flex items-center justify-center transition-opacity'>
          <Icon class='size-20' name={item.icon} />
        </div>
        <Image
          class='sponsorship-card-img mx-auto my-0 max-w-60 blur-sm transition-opacity'
          src={item.image}
          alt={`${item.name} 赞赏码`}
          loading='lazy'
        />
      </button>
    ))
  }
</div>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &[aria-pressed='true'],
    &:focus-visible {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
  @media (hover: hover) {
    .sponsorship-card:hover .sponsorship-card-icon {
      opacity: 0;
    }
    .sponsorship-card:hover .sponsorship-card-img {
      opacity: 1;
      --un-blur: blur(0);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.sponsorship-card').forEach((button) => {
    button.addEventListener('click', () => {
      const pressed = button.getAttribute('aria-pressed') !== 'true'
      button.setAttribute('aria-pressed', String(pressed))
    })
  })
</script>
