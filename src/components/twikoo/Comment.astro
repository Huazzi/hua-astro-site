---
import { cn } from 'astro-pure/utils'

import { comment } from '../../comment.config'

const { class: className } = Astro.props
const twikooConfig = comment.twikoo
---

{
  comment.provider === 'twikoo' && twikooConfig.enable && (
    <twikoo-comment>
      <p class='text-sm text-muted-foreground' data-comment-status role='status' aria-live='polite'>
        正在加载评论…
      </p>
      <div id='tcomment' class={cn('not-prose', className)} />
    </twikoo-comment>
  )
}

<script
  is:inline
  define:vars={{ cdn: twikooConfig.cdn, envId: twikooConfig.envId, lang: twikooConfig.lang }}
>
  const getTwikoo = () => globalThis.twikoo

  class TwikooComment extends HTMLElement {
    connectedCallback() {
      const el = this.querySelector('#tcomment')
      const status = this.querySelector('[data-comment-status]')
      if (!el || !status) return

      const fail = (reason, error) => {
        status.hidden = false
        status.setAttribute('role', 'alert')
        status.textContent = '评论暂时无法加载，请稍后重试。'
        console.error(`Twikoo ${reason}:`, error)
      }
      const initTwikoo = () => {
        try {
          const twikoo = getTwikoo()
          if (!twikoo) {
            fail('init unavailable', envId)
            return
          }
          Promise.resolve(
            twikoo.init({
              el,
              envId,
              lang,
              path: window.location.pathname
            })
          ).then(
            () => {
              status.hidden = true
            },
            (error) => fail('init failed', error)
          )
        } catch (error) {
          fail('init failed', error)
        }
      }

      if (getTwikoo()) {
        initTwikoo()
        return
      }

      const existingScript = document.querySelector(`script[data-twikoo-cdn="${cdn}"]`)

      if (existingScript) {
        if (existingScript.dataset.state === 'error') fail('script load failed', cdn)
        else if (existingScript.dataset.state === 'loaded') initTwikoo()
        else {
          existingScript.addEventListener('load', initTwikoo, { once: true })
          existingScript.addEventListener('error', () => fail('script load failed', cdn), {
            once: true
          })
        }
        return
      }

      const script = document.createElement('script')
      script.src = cdn
      script.async = true
      script.dataset.twikooCdn = cdn
      script.addEventListener(
        'load',
        () => {
          script.dataset.state = 'loaded'
          initTwikoo()
        },
        { once: true }
      )
      script.addEventListener(
        'error',
        () => {
          script.dataset.state = 'error'
          fail('script load failed', cdn)
        },
        { once: true }
      )
      document.head.append(script)
    }
  }

  if (!customElements.get('twikoo-comment')) customElements.define('twikoo-comment', TwikooComment)
</script>

<style>
  #tcomment {
    color: hsl(var(--muted-foreground) / var(--un-text-opacity, 1));
  }

  #tcomment :global(a) {
    color: hsl(var(--primary) / var(--un-text-opacity, 1));
    overflow-wrap: anywhere;
  }

  #tcomment :global(.tk-content, .tk-nick, .tk-extra-text, .tk-preview-container) {
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>
