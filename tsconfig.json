{
  "extends": "astro/tsconfigs/strict",
  "include": ["./.astro/types.d.ts", "./**/*"],
  "compilerOptions": {
    // Basic
    "allowJs": true,
    // Building for a library
    "declaration": true,
    // Code runs in the DOM
    "lib": ["es2022", "dom", "dom.iterable"],
    // Type Imports
    "verbatimModuleSyntax": true,
    // Others
    "strictNullChecks": true,
    // Paths
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/public/*": ["./public/*"],
      "@/components/*": ["./src/components/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/utils": ["./src/utils/index.ts"],
      "@/utils/*": ["./src/utils/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/types": ["./src/types/index.ts"],
      "@/site-config": ["./src/site.config.ts"],
      "@astro-pure/advanced/*": ["./node_modules/astro-pure/components/advanced/*"],
      "@astro-pure/basic/*": ["./node_modules/astro-pure/components/basic/*"],
      "@astro-pure/pages/*": ["./node_modules/astro-pure/components/pages/*"],
      "@astro-pure/user/*": ["./node_modules/astro-pure/components/user/*"]
    }
  },
  "exclude": [
    "./node_modules",
    "./**/node_modules/*",
    "./.vscode",
    "./dist",
    "./public/scripts/*",
    "./test/*"
  ]
}
